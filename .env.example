# Frontend (Vite exposes only VITE_* variables to browser code)
VITE_API_URL=http://localhost:8000/api/v1

# PostgreSQL connection used by the API and Alembic
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Object Storage (private bucket)
NEON_STORAGE_BUCKET=socrite-materials
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# OpenAI-compatible API
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=YOUR_AI_API_KEY
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional USD per million tokens; set the current rates for the selected provider/models.
# AI_CHAT_INPUT_USD_PER_MILLION=
# AI_CHAT_OUTPUT_USD_PER_MILLION=
# AI_EMBEDDING_USD_PER_MILLION=

# Registration access
ADMIN_EMAILS=admin@example.com
TEACHER_EMAILS=teacher@example.com

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=100
ABANDONED_UPLOAD_HOURS=24
