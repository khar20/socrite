# Frontend (Vite exposes only VITE_* variables to browser code)
VITE_API_URL=http://localhost:8000/api/v1

# PostgreSQL connection used by the API and Alembic
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Object Storage (private bucket)
NEON_STORAGE_BUCKET=socrite-materials
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# OpenRouter (OpenAI-compatible API). The API key is read only by the backend.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=YOUR_OPENROUTER_API_KEY
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Registration access
ADMIN_EMAILS=admin@example.com
TEACHER_EMAILS=teacher@example.com

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=100
ABANDONED_UPLOAD_HOURS=24
# Process queued material jobs inside the API when no dedicated worker runs.
WORKER_IN_API=true
