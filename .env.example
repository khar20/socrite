# Frontend (Vite exposes only VITE_* variables to browser code)
VITE_API_URL=http://localhost:8000/api/v1
VITE_NEON_AUTH_URL=https://YOUR-AUTH-ENDPOINT/neondb/auth

# Neon PostgreSQL: pooled URL for the app; direct URL for Alembic migrations
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Managed Auth
NEON_AUTH_URL=https://YOUR-AUTH-ENDPOINT/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-AUTH-ENDPOINT/neondb/auth/.well-known/jwks.json

# Neon Object Storage (private bucket)
NEON_STORAGE_BUCKET=socrite-materials
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# OpenAI-compatible API
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=YOUR_AI_API_KEY
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Teacher access
TEACHER_EMAILS=teacher@example.com

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=100
